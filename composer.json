{
    "name": "scrapyard-io/autopen",
    "description": "The ScrapyardIO Extended Fonts package.",
    "license": "MIT",
    "homepage": "https://scrapyard-io.projectsaturnstudios.com/ecosystem/scrapyard-io/autopen/0.7.x",
    "version": "0.7.0",
    "support": {
        "issues": "https://github.com/scrapyard-io/autopen/issues",
        "source": "https://github.com/scrapyard-io/autopen"
    },
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "^8.4|^8.5|^8.6",
        "scrapyard-io/tubes": "^0.7.0"
    },
    "require-dev": {
        "pestphp/pest": "^4"
    },
    "autoload": {
        "psr-4": {
            "ScrapyardIO\\Fonts\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ScrapyardIO\\Fonts\\Tests\\": "tests/"
        }
    },
    "extra": {
        "scrapyard-io": {
            "providers": [
                "ScrapyardIO\\Fonts\\AutopenServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-master": "0.7.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
